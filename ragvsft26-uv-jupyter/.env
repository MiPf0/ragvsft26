# ============================================================
# Ollama Configuration
# ============================================================
# URL to reach Ollama from inside the Docker container.
# "host.docker.internal" resolves to the host machine on Docker Desktop (Mac/Windows).
# On Linux, you may need to use the host's LAN IP or add --add-host=host.docker.internal:host-gateway
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Default model to use in notebooks (change to whatever you have pulled locally)
OLLAMA_DEFAULT_MODEL=llama3.1

# OpenAI SDK compatible endpoint (Ollama exposes this at /v1)
OPENAI_SDK_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_FAKE_API_KEY=ollama

# ============================================================
# Jupyter Configuration
# ============================================================
JUPYTER_PORT=8888
JUPYTER_TOKEN=dev-token-ragvsft26

# ============================================================
# Project Configuration
# ============================================================
PROJECT_NAME=ragvsft26
PYTHON_VERSION=3.12
